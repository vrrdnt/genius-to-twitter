# Genius artist IDs, comma-separated. Find the numeric ID in a Genius artist API response.
ARTIST_IDS=3158,96862,1840820
GENIUS_ACCESS_TOKEN=

# Add names used in section headings when they differ from the Genius artist name.
# The historical configuration uses "Rory" in some section headings.
ARTIST_ALIASES=Rory,Rory Ferreira

# X OAuth 1.0a user-context credentials. The X app must have Read and Write permission.
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Safety switch: the daemon prints previews until this is explicitly enabled.
PUBLISH_ENABLED=false

# Three posts a day at 10:00, 14:00, and 18:00 in the configured IANA timezone.
POST_SCHEDULE="0 10,14,18 * * *"
TIMEZONE=UTC
POST_ON_START=false

# Runtime state lives on the persistent Docker volume.
DATA_DIR=/data
CATALOG_MAX_AGE_HOURS=24
HISTORY_LIMIT=200
MAX_SONG_ATTEMPTS=8

# Snippet selection.
MIN_LINES=2
MAX_LINES=4
MIN_CHARACTERS=35
MAX_POST_LENGTH=280

# Optional, comma-separated case-insensitive terms that must not appear in a post.
EXCLUDED_TERMS=
