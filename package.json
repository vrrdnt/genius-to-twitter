{
  "name": "genius-to-twitter",
  "version": "2.0.0",
  "description": "A scheduled Docker bot that posts coherent lyric snippets to X",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/cli.js daemon",
    "post": "node src/cli.js post",
    "publish": "node src/cli.js post --publish",
    "sync": "node src/cli.js sync",
    "test:live": "node scripts/live-selector-preview.js",
    "check": "node --test",
    "test": "node --test"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "genius",
    "lyrics",
    "twitter",
    "x-api"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "genius-lyrics": "^4.4.7",
    "node-cron": "^4.6.0",
    "node-html-parser": "6.1.13",
    "twitter-api-v2": "^1.29.0",
    "undici": "^6.27.0"
  },
  "overrides": {
    "undici": "^6.27.0"
  }
}
